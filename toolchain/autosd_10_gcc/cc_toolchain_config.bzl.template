"""AutoSD GCC toolchain configuration with shared compiler policy."""

load("@bazel_tools//tools/build_defs/cc:action_names.bzl", "ACTION_NAMES")
load(
    "@bazel_tools//tools/cpp:cc_toolchain_config_lib.bzl",
    "feature",
    "flag_group",
    "flag_set",
    "tool_path",
    "with_feature_set",
)
load(
    "{FEATURE_INJECTION_BZL}",
    "FeatureInfo",
    "convert_feature",
)

_C_COMPILE_ACTIONS = [ACTION_NAMES.c_compile]
_CXX_COMPILE_ACTIONS = [
    ACTION_NAMES.cpp_compile,
    ACTION_NAMES.linkstamp_compile,
    ACTION_NAMES.cpp_header_parsing,
    ACTION_NAMES.cpp_module_compile,
    ACTION_NAMES.cpp_module_codegen,
    ACTION_NAMES.clif_match,
    ACTION_NAMES.lto_backend,
]
_COMPILE_ACTIONS = _C_COMPILE_ACTIONS + _CXX_COMPILE_ACTIONS + [
    ACTION_NAMES.assemble,
    ACTION_NAMES.preprocess_assemble,
]
_LINK_ACTIONS = [
    ACTION_NAMES.cpp_link_executable,
    ACTION_NAMES.cpp_link_dynamic_library,
    ACTION_NAMES.cpp_link_nodeps_dynamic_library,
]

def _flag_groups(flags):
    return [flag_group(flags = flags)] if flags else []

def _score_features(ctx):
    """Combine AutoSD compiler defaults with the upstream GCC warning policy."""
    cpu_flags = ["-m64"] if ctx.attr.target_arch == "x86_64" else []
    return [
        feature(name = "dbg"),
        feature(name = "opt"),
        feature(name = "fastbuild"),
        feature(name = "gnu11"),
        feature(
            name = "unfiltered_compile_flags",
            enabled = True,
            flag_sets = [flag_set(
                actions = _C_COMPILE_ACTIONS + _CXX_COMPILE_ACTIONS,
                flag_groups = _flag_groups([
                    '-D__DATE__="redacted"',
                    '-D__TIMESTAMP__="redacted"',
                    '-D__TIME__="redacted"',
                    "-Wno-builtin-macro-redefined",
                ]),
            )],
        ),
        feature(
            name = "score_compile_flags",
            enabled = True,
            flag_sets = [
                flag_set(
                    actions = _COMPILE_ACTIONS,
                    flag_groups = _flag_groups([
                        "-U_FORTIFY_SOURCE",
                        "-D_XOPEN_SOURCE=700",
                        "-fstack-protector",
                        "-fdiagnostics-color=always",
                        "-fno-omit-frame-pointer",
                        "-ffunction-sections",
                        "-fdata-sections",
                        "-fno-canonical-system-headers",
                        "-no-canonical-prefixes",
                        "-z noexecstack",
                    ] + cpu_flags),
                ),
                flag_set(
                    actions = _C_COMPILE_ACTIONS,
                    flag_groups = _flag_groups(["-std=c11"]),
                    with_features = [with_feature_set(not_features = ["gnu11"])],
                ),
                flag_set(
                    actions = _C_COMPILE_ACTIONS,
                    flag_groups = _flag_groups(["-std=gnu11"]),
                    with_features = [with_feature_set(features = ["gnu11"])],
                ),
                flag_set(actions = _CXX_COMPILE_ACTIONS, flag_groups = _flag_groups(["-std=c++17"])),
                flag_set(
                    actions = _COMPILE_ACTIONS,
                    flag_groups = _flag_groups(["-Og", "-g3"]),
                    with_features = [with_feature_set(features = ["dbg"])],
                ),
                flag_set(
                    actions = _COMPILE_ACTIONS,
                    flag_groups = _flag_groups(["-O2", "-DNDEBUG"]),
                    with_features = [
                        with_feature_set(features = ["opt"]),
                        with_feature_set(features = ["fastbuild"]),
                    ],
                ),
            ],
        ),
    ] + [
        convert_feature(
            policy[FeatureInfo],
            enabled = policy[FeatureInfo].name == "minimal_warnings",
        )
        for policy in ctx.attr._warning_features
    ]

def _impl(ctx):
    tool_paths = [
        tool_path(name = "gcc", path = "usr/bin/gcc"),
        tool_path(name = "g++", path = "usr/bin/g++"),
        tool_path(name = "ld", path = "usr/bin/ld"),
        tool_path(name = "ar", path = "usr/bin/ar"),
        tool_path(name = "as", path = "usr/bin/as"),
        tool_path(name = "cpp", path = "usr/bin/cpp"),
        tool_path(name = "gcov", path = "usr/bin/gcov"),
        tool_path(name = "nm", path = "usr/bin/nm"),
        tool_path(name = "objdump", path = "usr/bin/objdump"),
        tool_path(name = "strip", path = "usr/bin/strip"),
    ]
    standalone_compile_flags = [] if ctx.attr.use_score_flags else [
        "-Wall",
        "-Wextra",
        "-Wno-builtin-macro-redefined",
        "-D__DATE__=redacted",
        "-D__TIMESTAMP__=redacted",
        "-D__TIME__=redacted",
    ]

    # Compiler flags
    default_compile_flags = feature(
        name = "default_compile_flags",
        enabled = True,
        flag_sets = [
            flag_set(
                actions = [ACTION_NAMES.c_compile],
                flag_groups = [
                    flag_group(
                        flags = [
                            "-B" + "external/{REPO_NAME}/usr/bin",
                            "--sysroot=" + "external/{REPO_NAME}",
                            "-nostdinc",
                            "-isystem",
                            "external/{REPO_NAME}/usr/lib/gcc/" + ctx.attr.target_arch + "-redhat-linux/" + ctx.attr.gcc_version.split(".")[0] + "/include",
                            "-isystem",
                            "external/{REPO_NAME}/usr/include",
                        ] + standalone_compile_flags,
                    ),
                ],
            ),
            flag_set(
                actions = [ACTION_NAMES.cpp_compile],
                flag_groups = [
                    flag_group(
                        flags = [
                            "-B" + "external/{REPO_NAME}/usr/bin",
                            "--sysroot=" + "external/{REPO_NAME}",
                            "-nostdinc++",
                            "-isystem",
                            "external/{REPO_NAME}/usr/include/c++/" + ctx.attr.gcc_version.split(".")[0],
                            "-isystem",
                            "external/{REPO_NAME}/usr/include/c++/" + ctx.attr.gcc_version.split(".")[0] + "/" + ctx.attr.target_arch + "-redhat-linux",
                            "-isystem",
                            "external/{REPO_NAME}/usr/include/c++/" + ctx.attr.gcc_version.split(".")[0] + "/backward",
                            "-nostdinc",
                            "-isystem",
                            "external/{REPO_NAME}/usr/lib/gcc/" + ctx.attr.target_arch + "-redhat-linux/" + ctx.attr.gcc_version.split(".")[0] + "/include",
                            "-isystem",
                            "external/{REPO_NAME}/usr/include",
                        ] + standalone_compile_flags,
                    ),
                ],
            ),
        ],
    )

    default_link_flags = feature(
        name = "default_link_flags",
        enabled = True,
        flag_sets = [
            flag_set(
                actions = _LINK_ACTIONS,
                flag_groups = [
                    flag_group(
                        flags = [
                            "-B" + "external/{REPO_NAME}/usr/bin",
                            "--sysroot=" + "external/{REPO_NAME}",
                            "-Wl,--sysroot=" + "external/{REPO_NAME}",
                            "-L" + "external/{REPO_NAME}/lib64",
                            "-L" + "external/{REPO_NAME}/lib",
                            "-L" + "external/{REPO_NAME}/usr/lib/gcc/" + ctx.attr.target_arch + "-redhat-linux/" + ctx.attr.gcc_version.split(".")[0],
                            "-L" + "external/{REPO_NAME}/usr/lib64",
                            "-L" + "external/{REPO_NAME}/usr/lib",
                            "-Wl,-rpath-link," + "external/{REPO_NAME}/lib64",
                            "-Wl,-rpath-link," + "external/{REPO_NAME}/lib",
                            "-Wl,-rpath-link," + "external/{REPO_NAME}/usr/lib64",
                            "-Wl,-rpath-link," + "external/{REPO_NAME}/usr/lib",
                            "-lstdc++",
                            "-lm",
                        ],
                    ),
                ],
            ),
        ],
    )

    # Feature to disable absolute path warnings for system headers
    supports_header_path_normalization = feature(
        name = "supports_header_path_normalization",
        enabled = True,
    )

    # Custom flags follow the inherited policy so later settings can override it.
    custom_flags = feature(
        name = "autosd_custom_flags",
        enabled = True,
        flag_sets = [
            flag_set(actions = _C_COMPILE_ACTIONS, flag_groups = _flag_groups(ctx.attr.c_flags)),
            flag_set(actions = _CXX_COMPILE_ACTIONS, flag_groups = _flag_groups(ctx.attr.cxx_flags)),
            flag_set(actions = _LINK_ACTIONS, flag_groups = _flag_groups(ctx.attr.link_flags)),
        ],
    )
    features = [default_compile_flags, default_link_flags, supports_header_path_normalization]
    if ctx.attr.use_score_flags:
        features.extend(_score_features(ctx))
    features.append(custom_flags)

    return cc_common.create_cc_toolchain_config_info(
        ctx = ctx,
        features = features,
        cxx_builtin_include_directories = ctx.attr.include_dirs,
        toolchain_identifier = "{DISTRO_NAME}-gcc-{}".format(ctx.attr.gcc_version),
        host_system_name = "local",
        target_system_name = "local",
        target_cpu = ctx.attr.target_arch,
        target_libc = "glibc",
        compiler = "gcc",
        abi_version = "unknown",
        abi_libc_version = "unknown",
        tool_paths = tool_paths,
    )

cc_toolchain_config = rule(
    implementation = _impl,
    attrs = {
        "gcc_version": attr.string(mandatory = True),
        "target_arch": attr.string(mandatory = True),
        "include_dirs": attr.string_list(),
        "c_flags": attr.string_list(),
        "cxx_flags": attr.string_list(),
        "link_flags": attr.string_list(),
        "use_score_flags": attr.bool(default = True),
        "_warning_features": attr.label_list(
            default = [
                Label("{MINIMAL_WARNINGS}"),
                Label("{STRICT_WARNINGS}"),
                Label("{ALL_WALL_WARNINGS}"),
                Label("{WARNINGS_AS_ERRORS}"),
            ],
            providers = [FeatureInfo],
        ),
    },
    provides = [CcToolchainConfigInfo],
)
