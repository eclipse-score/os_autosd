#
# Cross toolchain BUILD: the compiler runs on {HOST_ARCH} and emits {TARGET_ARCH}
# code. Tools are prefixed with the target tuple ({TARGET_TUPLE}-) and live in the
# per-arch ./{HOST_ARCH} subtree; the target sysroot lives under ./{TARGET_ARCH}.
load(":cc_toolchain_config.bzl", "cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

# File groups for different tool categories
filegroup(
    name = "all_files",
    srcs = glob(["**/*"]),
)

# All files of the target sysroot (headers + libs). Useful for consumers that
# need the target headers at build time, e.g. bindgen build scripts that must
# read target headers instead of the host's.
filegroup(
    name = "sysroot_files",
    srcs = glob(["{TARGET_ARCH}/**"], allow_empty = True),
)

filegroup(
    name = "compiler_files",
    srcs = [
        "{HOST_ARCH}/usr/bin/{TARGET_TUPLE}-gcc",
        "{HOST_ARCH}/usr/bin/{TARGET_TUPLE}-g++",
        "{HOST_ARCH}/usr/bin/{TARGET_TUPLE}-cpp",
        "{HOST_ARCH}/usr/bin/{TARGET_TUPLE}-as",
    ] + glob([
        # Host tools, their runtime libs and the compiler's own guts.
        "{HOST_ARCH}/usr/bin/{TARGET_TUPLE}-*_original",
        "{HOST_ARCH}/usr/lib/gcc/**/*",
        "{HOST_ARCH}/usr/libexec/**/*",
        "{HOST_ARCH}/usr/lib64/**/*.so*",
        # Target headers and runtime bits from the sysroot.
        "{TARGET_ARCH}/usr/include/**/*",
        "{TARGET_ARCH}/usr/lib/gcc/**/*",
        "{TARGET_ARCH}/usr/lib64/**/*.so*",
        "{TARGET_ARCH}/usr/lib/**/*.so*",
        "{TARGET_ARCH}/lib64/**/*",
        "{TARGET_ARCH}/lib/**/*",
    ], allow_empty = True),
)

filegroup(
    name = "linker_files",
    srcs = [
        "{HOST_ARCH}/usr/bin/{TARGET_TUPLE}-gcc",
        "{HOST_ARCH}/usr/bin/{TARGET_TUPLE}-g++",
        "{HOST_ARCH}/usr/bin/{TARGET_TUPLE}-ld",
        "{HOST_ARCH}/usr/bin/{TARGET_TUPLE}-ld.bfd",
    ] + glob([
        "{HOST_ARCH}/usr/bin/{TARGET_TUPLE}-ld*_original",
        "{HOST_ARCH}/usr/bin/{TARGET_TUPLE}-as*_original",
        "{HOST_ARCH}/usr/lib/gcc/**/*.a",
        "{HOST_ARCH}/usr/lib/gcc/**/*.o",
        "{HOST_ARCH}/usr/lib/gcc/**/*.so*",
        "{HOST_ARCH}/usr/lib64/**/*.so*",
        "{TARGET_ARCH}/usr/lib/gcc/**/*",
        "{TARGET_ARCH}/usr/lib64/**/*",
        "{TARGET_ARCH}/usr/lib/**/*",
        "{TARGET_ARCH}/lib64/**/*",
        "{TARGET_ARCH}/lib/**/*",
    ], allow_empty = True),
)

filegroup(
    name = "ar_files",
    srcs = ["{HOST_ARCH}/usr/bin/{TARGET_TUPLE}-ar"],
)

filegroup(
    name = "objcopy_files",
    srcs = ["{HOST_ARCH}/usr/bin/{TARGET_TUPLE}-objcopy"],
)

filegroup(
    name = "strip_files",
    srcs = ["{HOST_ARCH}/usr/bin/{TARGET_TUPLE}-strip"],
)

filegroup(
    name = "empty",
    srcs = [],
)

# Toolchain configuration
cc_toolchain_config(
    name = "gcc_toolchain_config",
    gcc_version = "{GCC_VERSION}",
    target_arch = "{TARGET_ARCH}",
    target_tuple = "{TARGET_TUPLE}",
    include_dirs = [
        "external/{REPO_NAME}/{HOST_ARCH}/usr/lib/gcc/{TARGET_TUPLE}/{GCC_MAJOR}/include",
        "external/{REPO_NAME}/{TARGET_ARCH}/usr/include",
        "external/{REPO_NAME}/{TARGET_ARCH}/usr/include/c++/{GCC_MAJOR}",
        "external/{REPO_NAME}/{TARGET_ARCH}/usr/include/c++/{GCC_MAJOR}/{TARGET_TUPLE}",
        "external/{REPO_NAME}/{TARGET_ARCH}/usr/include/c++/{GCC_MAJOR}/backward",
    ],
    c_flags = [{C_FLAGS}],
    cxx_flags = [{CXX_FLAGS}],
    link_flags = [{LINK_FLAGS}],
)

# The actual toolchain
cc_toolchain(
    name = "gcc_toolchain",
    all_files = ":all_files",
    ar_files = ":ar_files",
    compiler_files = ":compiler_files",
    dwp_files = ":empty",
    linker_files = ":linker_files",
    objcopy_files = ":objcopy_files",
    strip_files = ":strip_files",
    supports_param_files = 1,
    toolchain_config = ":gcc_toolchain_config",
)

# Toolchain definition for registration. Distinct target: it executes on the
# host ({HOST_ARCH}) but is only selected for {TARGET_ARCH} targets, so it never
# mixes with the native {HOST_ARCH} toolchain.
toolchain(
    name = "cross_gcc_toolchain_{HOST_ARCH}_{TARGET_ARCH}",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:{HOST_ARCH}",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:{TARGET_ARCH}",
    ],
    toolchain = ":gcc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)
