From 7794300032658a504466941f8733415b0bbcb2a0 Mon Sep 17 00:00:00 2001
From: odra <lrossett@redhat.com>
Date: Tue, 8 Sep 2026 09:34:36 -0300
Subject: [PATCH] fix: use stable core::str::from_utf8_unchecked in ffi

Signed-off-by: odra <lrossett@redhat.com>
---
 score/log_rust/stdout_logger_cpp_init/ffi.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/score/log_rust/stdout_logger_cpp_init/ffi.rs b/score/log_rust/stdout_logger_cpp_init/ffi.rs
index 3716761f1b..749eb8c484 100644
--- a/score/log_rust/stdout_logger_cpp_init/ffi.rs
+++ b/score/log_rust/stdout_logger_cpp_init/ffi.rs
@@ -59,7 +59,7 @@ extern "C" fn set_default_logger(
     if !context_ptr.is_null() {
         let context = unsafe {
             let slice = from_raw_parts(context_ptr.cast(), context_size);
-            str::from_utf8_unchecked(slice)
+            core::str::from_utf8_unchecked(slice)
         };
         builder = builder.context(context);
     }
-- 
2.55.0

