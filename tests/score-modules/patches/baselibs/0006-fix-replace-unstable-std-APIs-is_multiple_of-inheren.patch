From 31c16d2010a103e7a9f2df781ec91246c2835417 Mon Sep 17 00:00:00 2001
From: odra <lrossett@redhat.com>
Date: Tue, 8 Sep 2026 09:28:58 -0300
Subject: [PATCH] fix: replace unstable std APIs (is_multiple_of, inherent
 str::from_utf8, [_; _]) with stable equivalents

Signed-off-by: odra <lrossett@redhat.com>
---
 score/log_rust/stdout_logger/lib.rs       |  2 +-
 score/log_rust/stdout_logger/timestamp.rs | 10 +++++-----
 score/pal/affinity.rs                     |  2 +-
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/score/log_rust/stdout_logger/lib.rs b/score/log_rust/stdout_logger/lib.rs
index 174a90f0a9..7a9942836e 100644
--- a/score/log_rust/stdout_logger/lib.rs
+++ b/score/log_rust/stdout_logger/lib.rs
@@ -291,7 +291,7 @@ impl Log for StdoutLogger {
             if self.show_timestamp {
                 if let Ok(now) = SystemTime::now().duration_since(UNIX_EPOCH) {
                     let timestamp_u8 = timestamp(now);
-                    let timestamp_str = unsafe { str::from_utf8_unchecked(timestamp_u8.as_slice()) };
+                    let timestamp_str = unsafe { core::str::from_utf8_unchecked(timestamp_u8.as_slice()) };
                     let _ = score_write!(writer, "[{}]", timestamp_str);
                 }
             }
diff --git a/score/log_rust/stdout_logger/timestamp.rs b/score/log_rust/stdout_logger/timestamp.rs
index 573f8fb664..f2bd12630d 100644
--- a/score/log_rust/stdout_logger/timestamp.rs
+++ b/score/log_rust/stdout_logger/timestamp.rs
@@ -20,7 +20,7 @@ use core::time::Duration;
 
 /// Determine if provided year is a leap year.
 fn is_leap_year(year: u64) -> bool {
-    (year.is_multiple_of(4) && !year.is_multiple_of(100)) || year.is_multiple_of(400)
+    (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
 }
 
 /// Calculate time - hour, minute, second.
@@ -113,7 +113,7 @@ pub fn timestamp(duration_since_epoch_start: Duration) -> [u8; 27] {
     let (year, month, day) = get_date(days_in_epoch);
 
     // Format output as `u8` array of known size.
-    let mut output = [0; _];
+    let mut output = [0u8; 27];
 
     // Write date in `YYYY/MM/dd ` format.
     write::<4>(&mut output[0..4], year);
@@ -204,7 +204,7 @@ mod tests {
     fn test_timestamp_zero() {
         let duration = Duration::from_secs(0);
         let ts_u8 = timestamp(duration);
-        let ts_str = str::from_utf8(ts_u8.as_slice()).unwrap();
+        let ts_str = core::str::from_utf8(ts_u8.as_slice()).unwrap();
         assert_eq!(ts_str, "1970/01/01 00:00:00.0000000");
     }
 
@@ -212,7 +212,7 @@ mod tests {
     fn test_timestamp_in_range() {
         let duration = Duration::from_secs(1769604017) + Duration::from_nanos(123456789);
         let ts_u8 = timestamp(duration);
-        let ts_str = str::from_utf8(ts_u8.as_slice()).unwrap();
+        let ts_str = core::str::from_utf8(ts_u8.as_slice()).unwrap();
         assert_eq!(ts_str, "2026/01/28 12:40:17.1234567");
     }
 
@@ -220,7 +220,7 @@ mod tests {
     fn test_timestamp_max_allowed() {
         let duration = Duration::from_secs(253402300799) + Duration::from_nanos(999999999);
         let ts_u8 = timestamp(duration);
-        let ts_str = str::from_utf8(ts_u8.as_slice()).unwrap();
+        let ts_str = core::str::from_utf8(ts_u8.as_slice()).unwrap();
         assert_eq!(ts_str, "9999/12/31 23:59:59.9999999");
     }
 
diff --git a/score/pal/affinity.rs b/score/pal/affinity.rs
index 13df77f614..903c5a5ecf 100644
--- a/score/pal/affinity.rs
+++ b/score/pal/affinity.rs
@@ -63,7 +63,7 @@ impl CpuSet {
 
     /// Create mask based on provided list.
     fn create_mask(affinity: &[usize]) -> [u8; CPU_MASK_SIZE] {
-        let mut mask = [0u8; _];
+        let mut mask = [0u8; CPU_MASK_SIZE];
         for cpu_id in affinity.iter().copied() {
             const MAX_CPU_ID: usize = MAX_CPU_NUM - 1;
             assert!(
-- 
