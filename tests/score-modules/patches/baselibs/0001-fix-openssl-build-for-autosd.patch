From 4911a8465e762158fbbe413f1b25fa2a8751ffcc Mon Sep 17 00:00:00 2001
From: odra <lrossett@redhat.com>
Date: Tue, 8 Sep 2026 08:30:18 -0300
Subject: [PATCH] fix: openssl build for autosd

Signed-off-by: odra <lrossett@redhat.com>
---
 third_party/openssl/openssl_transition.bzl | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/third_party/openssl/openssl_transition.bzl b/third_party/openssl/openssl_transition.bzl
index cc194cbcd6..754fceeb25 100644
--- a/third_party/openssl/openssl_transition.bzl
+++ b/third_party/openssl/openssl_transition.bzl
@@ -44,14 +44,30 @@ def _openssl_transition_impl(settings, attr):
         if f not in _FEATURES_TO_DISABLE:
             updated.append(f)
     updated.append("gnu11")
+
+    # Expose glibc's GNU/Linux prototypes (e.g. syscall(), madvise()) that
+    # OpenSSL's secure-memory code needs. Toolchains that do not translate the
+    # "gnu11" feature into -std=gnu11 leave _GNU_SOURCE undefined, causing
+    # implicit-declaration errors, so define it explicitly here as well.
+    copts = list(settings["//command_line_option:copt"])
+    if "-D_GNU_SOURCE" not in copts:
+        copts.append("-D_GNU_SOURCE")
+
     return {
         "//command_line_option:features": updated,
+        "//command_line_option:copt": copts,
     }
 
 _openssl_transition = transition(
     implementation = _openssl_transition_impl,
-    inputs = ["//command_line_option:features"],
-    outputs = ["//command_line_option:features"],
+    inputs = [
+        "//command_line_option:features",
+        "//command_line_option:copt",
+    ],
+    outputs = [
+        "//command_line_option:features",
+        "//command_line_option:copt",
+    ],
 )
 
 def _openssl_library_impl(ctx):
-- 
2.55.0

