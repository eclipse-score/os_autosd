"""Repository rule for downloading and extracting AutoSD RPM packages."""

load(":rpm.bzl", "find_rpm_url")

DISTROS = {
    "autosd10": {
        "repositories": {
            "aarch64": "https://autosd.sig.centos.org/AutoSD-10/nightly/repos/AutoSD/compose/AutoSD/aarch64/os/Packages/",
            "x86_64": "https://autosd.sig.centos.org/AutoSD-10/nightly/repos/AutoSD/compose/AutoSD/x86_64/os/Packages/",
        },
    },
}

# Used only when `build` is not provided.
_DEFAULT_BUILD_FILE = '''\
# Generated by @autosd_rpm. Pass `build = "//path:your.BUILD"` to replace this.
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all",
    srcs = glob(["**"], exclude = ["BUILD.bazel", "WORKSPACE", "WORKSPACE.bazel"]),
)
'''

def _autosd_rpm_impl(rctx):
    base_url = DISTROS[rctx.attr.distro]["repositories"][rctx.attr.arch]
    packages = list(rctx.attr.packages)
    if rctx.attr.package:
        packages = [rctx.attr.package] + packages

    if not packages:
        fail("autosd_rpm: set `package` or `packages` on '{}'".format(rctx.attr.name))

    # Resolve package names to URLs via a single read of the index page.
    urls = []
    result = rctx.download(url = base_url, output = "_index.html")
    if not result.success:
        fail("autosd_rpm: failed to download index page: {}".format(base_url))
    index = rctx.read("_index.html")
    rctx.delete("_index.html")
    for package in packages:
        urls.append(find_rpm_url(index, base_url, package, rctx.attr.arch))

    script = rctx.path(rctx.attr._extract_script)
    for i, url in enumerate(urls):
        rpm_file = "_pkg{}.rpm".format(i)
        tar_file = "_pkg{}.tar".format(i)
        download_kwargs = {"url": url, "output": rpm_file}
        if rctx.attr.sha256 and len(urls) == 1:
            download_kwargs["sha256"] = rctx.attr.sha256
        if not rctx.download(**download_kwargs).success:
            fail("autosd_rpm: failed to download RPM: {}".format(url))

        res = rctx.execute(["bash", str(script), rpm_file, tar_file], quiet = False)
        if res.return_code != 0:
            fail("autosd_rpm: failed to unpack {}:\n{}".format(url, res.stderr))

        rctx.extract(archive = tar_file, output = ".")
        rctx.delete(rpm_file)
        rctx.delete(tar_file)

    if rctx.attr.build:
        rctx.file("BUILD.bazel", rctx.read(rctx.path(rctx.attr.build)))
    else:
        rctx.file("BUILD.bazel", _DEFAULT_BUILD_FILE)

autosd_rpm = repository_rule(
    implementation = _autosd_rpm_impl,
    doc = "Download RPM(s) by package name from the AutoSD compose repo and extract them.",
    attrs = {
        "package": attr.string(
            doc = "A package name to download, e.g. 'zlib-ng-compat'. Version is resolved automatically.",
        ),
        "packages": attr.string_list(
            doc = "Several package names, all extracted (merged) into a single repository.",
        ),
        "build": attr.label(
            allow_single_file = True,
            doc = "A BUILD file to install as this repository's BUILD.bazel. Defaults to a filegroup.",
        ),
        "distro": attr.string(
            default = "autosd10",
            doc = "Distro to download RPMs from.",
        ),
        "arch": attr.string(
            mandatory = True,
            doc = "RPM architecture to use, possible values are: aarch64 and x86_64",
        ),
        "sha256": attr.string(
            doc = "Optional expected SHA-256 (applied only when exactly one RPM is downloaded).",
        ),
        "_extract_script": attr.label(
            default = Label("//rules/autosd_dep:extract.sh"),
            allow_single_file = True,
        ),
    },
)
