bazel_dep(name = "os_autosd", version = "0.0.1")
# override with local path
local_path_override(
    module_name = "os_autosd",
    path = "../../",
)
bazel_dep(name = "rules_rpm", version = "0.0.1")
# override with local path
local_path_override(
    module_name = "rules_rpm",
    path = "../../toolchain/rpm"
)

autosd_10_gcc = use_extension("@os_autosd//toolchain/autosd_10_gcc:extensions.bzl", "autosd_10_gcc_extension")
use_repo(autosd_10_gcc, "autosd_10_gcc_repo")
register_toolchains("@autosd_10_gcc_repo//:gcc_toolchain_linux_x86_64")

# Register the RPM toolchain (using local toolchain from parent)
rpm_toolchain_ext = use_extension("@rules_rpm//toolchain:extensions.bzl", "rpm_toolchain")
use_repo(rpm_toolchain_ext, "rpm_toolchain")
register_toolchains(
    "@rules_rpm//toolchain:linux_x86_64",
    "@rules_rpm//toolchain:linux_aarch64",
)
