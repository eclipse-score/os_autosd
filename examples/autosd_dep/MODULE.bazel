module(name = "os_autosd_dep_example")

bazel_dep(name = "os_autosd", version = "0.0.0")
bazel_dep(name = "rules_cc", version = "0.2.16")

local_path_override(
    module_name = "os_autosd",
    path = "../..",
)

autosd_10_gcc = use_extension("@os_autosd//toolchain/autosd_10_gcc:extensions.bzl", "autosd_10_gcc_extension")

# AutoSD 10's provider of zlib-devel and its required runtime library.
# autosd_dep() takes RPM names and does not resolve dependencies or capabilities.
autosd_10_gcc.autosd_dep(name = "zlib-ng-compat-devel")
autosd_10_gcc.autosd_dep(name = "zlib-ng-compat")
use_repo(autosd_10_gcc, "autosd_10_gcc_repo")

register_toolchains("@autosd_10_gcc_repo//:gcc_toolchain_linux_x86_64")
